# Copy to .env and adjust as needed. docker-compose.yml assembles
# DATABASE_URL / REDIS_URL for the cubicle-api container from these values.

ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=cubicle
POSTGRES_USER=cubicle
POSTGRES_PASSWORD=cubicle

# Optional: needed to actually run agents (not just detect engine availability).
# Claude Code CLI engine and the Anthropic LiteLLM engine both read this.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: only used if you point an agent's engine_provider at "ollama"
# and run `docker compose --profile ollama up -d` (not enabled by default).
# OLLAMA_BASE_URL=http://ollama:11434

# Required to connect Claude Code CLI via Settings (encrypts the stored
# OAuth token at rest). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=

# Optional: the absolute path of this project's ./agent-workspaces folder on
# your own machine (not inside the container) — lets the file browser offer
# "copy folder path" so you can open agents' files in Explorer/VS Code.
# Windows example:
# HOST_WORKSPACES_PATH=C:\Users\you\path\to\cubicle\agent-workspaces

# Optional: enables real speech-to-text/text-to-speech on voice calls
# (app/voice/). Without it, calls still connect but just play a test tone
# and echo your own audio back. Get a key at https://sarvam.ai (dashboard
# > API Keys) — free tier available.
# SARVAM_API_KEY=
